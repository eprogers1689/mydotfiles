
# oh-my-zsh normally sets these up; do it here so the prompt works without it
autoload -U colors && colors
setopt prompt_subst

_fishy_collapsed_wd() {
  echo $(pwd | perl -pe "
   BEGIN {
      binmode STDIN,  ':encoding(UTF-8)';
      binmode STDOUT, ':encoding(UTF-8)';
   }; s|^$HOME|~|g; s|/([^/])[^/]*(?=/)|/\$1|g
")
}

_get_aws_account(){
  [[ -z "$AWS_PROFILE" ]] && return
  aws_account_name=${AWS_PROFILE:u}
  if [[ "$aws_account_name" =~ "TEST" ]]; then
    echo "%{$fg_bold[green]%} $aws_account_name%{$reset_color%}"
  elif [[ "$aws_account_name" =~ "QA" ]]; then
    echo "%{$fg_bold[yellow]%} $aws_account_name"%{$reset_color%}
  elif [[ "$aws_account_name" =~ "PROD" ]]; then
    echo "%{$fg_bold[red]%} $aws_account_name"%{$reset_color%}
  else
    echo "%{$fg_bold[blue]%} $aws_account_name"%{$reset_color%}
  fi
}

_prompt_git_branch(){
    # Check if we're in a Git repository
    if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
        echo ""
        return
    fi
    branch=$(git rev-parse --abbrev-ref HEAD)
    echo "(%{$fg_bold[blue]%}${branch}%{$reset_color%})"
}

_prompt_git_statuses() {
    # Check if we're in a Git repository
    if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
        echo ""
        return
    fi

    local git_status_output=$(git status --porcelain 2>/dev/null)
    local staged=$(echo "$git_status_output" | grep -c "^[MARCD]")
    local unstaged=$(echo "$git_status_output" | grep -c "^.[MARCD]")
    local untracked=$(echo "$git_status_output" | grep -c "^\?")
    local stashes=$(git stash list 2>/dev/null | wc -l | tr -d ' ')

    local statuses=""

    [[ ${staged} != 0 ]] && statuses+=" %{$fg[green]%}${staged}%{$reset_color%}"
    [[ ${unstaged} != 0 ]] && statuses+=" %{$fg[red]%}${unstaged}%{$reset_color%}"
    [[ ${untracked} != 0 ]] && statuses+=" %{$fg[gray]%}${untracked}%{$reset_color%}"
    [[ ${stashes} != 0 ]] && statuses+=" %{$fg[yellow]%}${stashes}%{$reset_color%}"

    if [[ -n "${statuses}" ]]; then
        # Trim leading whitespace
        statuses="${statuses## }"
        echo "[$statuses]"
    fi
}

_get_pulumi_stack() {
  # Skip if not a Pulumi project
  [[ ! -f "Pulumi.yaml" ]] && return 0

  local stackname=""

  # Try workspace file first (fast, shows actually selected stack)
  local hash=$(echo -n "$(pwd)" | shasum -a 256 | cut -d' ' -f1)
  local workspace_file="$HOME/.pulumi/workspaces/${hash}.json"
  if [[ -f "$workspace_file" ]]; then
    stackname=$(jq -r '.stack // empty' "$workspace_file" 2>/dev/null)
  fi

  # Fallback: check for single stack config (no slow find)
  if [[ -z "$stackname" ]]; then
    local configs=(Pulumi.*.yaml(N) config/Pulumi.*.yaml(N))
    if [[ ${#configs[@]} -eq 1 ]]; then
      stackname=$(basename "${configs[1]}" | sed 's/Pulumi.\(.*\)\.yaml/\1/')
    fi
  fi

  [[ -n "$stackname" ]] && echo "${lines_color} [🥞${lightgray}$stackname${lines_color}] %{$reset%}"
}

exit_code='%(?.👌.👎)'
local user_color='cyan'; [ $UID -eq 0 ] && user_color='red'
# https://zsh.sourceforge.io/Doc/Release/Prompt-Expansion.html
PROMPT='%{$fg_bold[$user_color]%}$(_fishy_collapsed_wd)$(_get_aws_account)$(_get_pulumi_stack)$exit_code$(_prompt_git_branch)%{$reset_color%}$(_prompt_git_statuses)%{$fg_bold[$user_color]%}%{$fg[green]%}%(!.#. $)%{$reset_color%} '
